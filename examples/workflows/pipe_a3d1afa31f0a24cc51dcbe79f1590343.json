{
    "edges": [
        {
            "family": "stream",
            "source": {
                "node": "sw-1",
                "port": "out"
            },
            "target": {
                "node": "sw-2",
                "port": "in"
            }
        }
    ],
    "nodes": {
        "sw-1": {
            "conf": {
                "attrs": [
                    {
                        "key": {
                            "type": "text",
                            "value": "url"
                        },
                        "value": {
                            "type": "text",
                            "value": "http://www.caltrain.com/Fares/farechart.html"
                        }
                    }
                ]
            },
            "family": "module",
            "id": "sw-1",
            "name": "itembuilder"
        },
        "sw-2": {
            "conf": {
                "rule": [
                    {
                        "field": {
                            "type": "text",
                            "value": "url"
                        },
                        "match": {
                            "type": "text",
                            "value": "http.*html"
                        },
                        "replace": {
                            "type": "text",
                            "value": "farechart"
                        }
                    }
                ]
            },
            "family": "module",
            "id": "sw-2",
            "name": "regex"
        }
    },
    "outputs": {
        "default": {
            "node": "sw-2",
            "port": "out"
        }
    },
    "version": "2"
}
