      "type": "input",
      "conf": {
        "test": {
          "type": "bool",
          "value": "true"
        },
        "default": {
          "type": "text",
          "value": "%B %d, %Y"
        },
        "prompt": {
          "type": "text",
          "value": "enter date format"
        },
        "name": {
          "type": "text",
          "value": "format_input"
        },
        "type": {
          "type": "text",
          "value": "text"
        }
      }
    },
    {
      "id": "sw-3",
      "type": "dateformat",
      "conf": {
        "format": {
          "terminal": "format",
          "type": "text"
        }
      },
      "field": "date",
      "emit": true
    },
    {
      "id": "sw-4",
      "type": "itembuilder",
      "conf": {
        "attrs": [
          {
            "key": {
              "type": "text",
              "value": "date"
            },
            "value": {
              "terminal": "attrs_1_value",
              "type": "text"
            }
          }
        ]
      }
    },
    {
      "id": "_OUTPUT",
      "type": "output",
      "conf": {}
    }
  ],
  "wires": [
    {
      "id": "_w1",
      "src": {
        "id": "_OUTPUT",
        "moduleid": "sw-1"
      },
      "tgt": {
        "id": "_INPUT",
