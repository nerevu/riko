      }
    },
    {
      "id": "_w3",
      "src": {
        "id": "_OUTPUT",
        "moduleid": "sw-2"
      },
      "tgt": {
        "id": "_INPUT",
        "moduleid": "sw-3"
      }
    },
    {
      "id": "_w4",
      "src": {
        "id": "_OUTPUT",
        "moduleid": "sw-3"
      },
      "tgt": {
        "id": "attrs_1_value",
        "moduleid": "sw-4"
      }
    },
    {
      "id": "_w5",
      "src": {
        "id": "_OUTPUT",
