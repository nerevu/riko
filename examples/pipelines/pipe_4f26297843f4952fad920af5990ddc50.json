{
  "modules": [
    {
      "id": "sw-1",
      "type": "itembuilder",
      "conf": {
        "attrs": [
          {
            "key": {
              "type": "text",
              "value": "content"
            },
            "value": {
              "type": "text",
              "value": "12/3/2014"
            }
          }
        ]
      }
    },
    {
      "id": "sw-2",
      "type": "datebuilder",
      "conf": {},
      "assign": "date"
    },
    {
