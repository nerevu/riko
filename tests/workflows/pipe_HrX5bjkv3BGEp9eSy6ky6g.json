            "id": "sw-157",
            "name": "fetch",
            "options": {
                "assign": "loop:fetch",
                "count": "all",
                "emit": true
            }
        },
        "sw-174": {
            "conf": {
                "rule": [
                    {
                        "dir": {
                            "type": "text",
                            "value": "ASC"
                        },
                        "field": {
