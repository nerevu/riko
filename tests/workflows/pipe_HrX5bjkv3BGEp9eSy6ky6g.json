                            "value": "pubDate"
                        },
                        "type": "datetime"
                    }
                ]
            },
            "family": "module",
            "id": "sw-174",
            "name": "sort"
        },
        "sw-191": {
            "conf": {
                "count": {
                    "type": "float",
