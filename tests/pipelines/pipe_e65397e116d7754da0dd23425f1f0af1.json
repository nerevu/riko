            "type": "regex",
            "conf": {
                "RULE": [
                    {
                        "field": {
                            "type": "text",
                            "value": "description"
                        },
                        "match": {
                            "type": "text",
                            "value": "(.*)"
                        },
                        "replace": {
                            "type": "text",
                            "value": "<img src=\"$1\" alt=\"QRcode\" /><br/>${title}"
                        }
                    }
                ]
            },
            "assign": "loop:regex",
            "emit": true,
            "count": "all"
        }
