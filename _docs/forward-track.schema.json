{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Riko Forward Track snapshot",
  "description": "Content contract for the existing roadmap layout. Arrays preserve display order. The renderer supplies visual styles, status captions, controls, standard headings, and the snapshot marker; it derives counts and filters from phase status. Work-item status is independent of phase status. Strings are plain text with optional inline backticks, never executable HTML.",
  "$comment": "Application checks: phase, milestone, and outcome IDs are unique and all dependency targets resolve to one of them. Focus references resolve; focus.phase is the sole next_up phase. Work IDs are unique within a phase. Stage IDs and step IDs are unique in their respective namespaces. Every step ref resolves to a phase or milestone. Bridge and outcome references resolve to their stage/step; input steps precede their dependent in the dependency graph. Check cycles across ordered lane steps and bridge connections. Parallel stage layout alone does not impose dependencies across lanes.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "snapshot": {"$ref": "#/$defs/snapshot"},
    "page": {"$ref": "#/$defs/page"},
    "focus": {"$ref": "#/$defs/focus"},
    "phases": {"type": "array", "items": {"$ref": "#/$defs/phase"}, "minItems": 1},
    "milestones": {"type": "array", "items": {"$ref": "#/$defs/milestone"}, "minItems": 1},
    "history": {"type": "array", "items": {"$ref": "#/$defs/historyEvent"}, "minItems": 0},
    "schedule": {"$ref": "#/$defs/schedule"}
  },
  "required": ["snapshot", "page", "focus", "phases", "milestones", "history", "schedule"],
  "$defs": {
    "link": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "pattern": "^https?://"}
      },
      "required": ["label", "url"]
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "branch": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[a-fA-F0-9]{7,64}$"},
        "date": {"type": "string", "format": "date"},
        "unreleasedVersion": {"type": "string", "minLength": 1},
        "repository": {"$ref": "#/$defs/link"},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/link"}, "minItems": 1}
      },
      "required": ["branch", "commit", "date", "unreleasedVersion", "repository", "sources"]
    },
    "page": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "brand": {"type": "string", "minLength": 1},
        "documentTitle": {"type": "string", "minLength": 1},
        "sectionLabel": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string", "minLength": 1},
        "historyCaption": {"type": "string", "minLength": 1},
        "outlook": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "heading": {"type": "string", "minLength": 1},
            "body": {"type": "string", "minLength": 1}
          },
          "required": ["heading", "body"]
        }
      },
      "required": ["brand", "documentTitle", "sectionLabel", "title", "subtitle", "historyCaption", "outlook"]
    },
    "focus": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "phase": {"type": "string", "pattern": "^R[0-9]+[A-Z]*$"},
        "milestone": {"type": "string", "pattern": "^M[0-9]+$"},
        "heading": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "decision": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "heading": {"type": "string", "minLength": 1},
            "body": {"type": "string", "minLength": 1}
          },
          "required": ["heading", "body"]
        }
      },
      "required": ["phase", "milestone", "heading", "summary"]
    },
    "workItem": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "description": "Unique within its phase. The slice tag may repeat."},
        "tag": {"type": "string", "minLength": 1, "description": "Optional display tag, e.g. bounded-split."},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["planned", "next_up", "in_progress", "complete", "phase_landed"]},
        "body": {"type": "string", "minLength": 1},
        "acceptance": {"type": "string", "minLength": 1, "description": "Acceptance text; use inline backticks for exact test names and code."},
        "planUrl": {"type": "string", "format": "uri", "pattern": "^https?://", "description": "Link to the item's paragraph at the snapshot commit."},
        "location": {"type": "string", "minLength": 1, "description": "Location trail, e.g. implementation-sequence.md › R7 › R7.fan-in."}
      },
      "required": ["id", "title", "status", "body"]
    },
    "dependency": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["unlocks", "scheduled_before", "proposed"]},
        "badge": {"type": "string", "minLength": 1, "description": "Compact card label, e.g. Before R6."},
        "detail": {"type": "string", "minLength": 1, "description": "Full explanation shown in the dialog."},
        "targets": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
      },
      "required": ["kind", "badge", "detail", "targets"]
    },
    "phase": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^R[0-9]+[A-Z]*$"},
        "title": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "status": {"enum": ["landed", "next_up", "pending"]},
        "planUrl": {"type": "string", "format": "uri", "pattern": "^https?://"},
        "dependency": {"$ref": "#/$defs/dependency"},
        "workKind": {"enum": ["implementation", "slices"]},
        "work": {"type": "array", "items": {"$ref": "#/$defs/workItem"}, "minItems": 1}
      },
      "required": ["id", "title", "purpose", "status", "planUrl", "dependency", "workKind", "work"]
    },
    "milestone": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^M[0-9]+$"},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "prerequisiteLabel": {"type": "string", "minLength": 1},
        "planUrl": {"type": "string", "format": "uri", "pattern": "^https?://"},
        "date": {"type": "string", "format": "date"}
      },
      "required": ["id", "title", "summary", "prerequisiteLabel", "planUrl"]
    },
    "historyEvent": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "when": {"type": "string", "minLength": 1, "description": "Display precision as recorded, including ranges, relative gaps or By 14 Nov."},
        "badge": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1}
      },
      "required": ["when", "badge", "title"]
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "description": "Unique across the schedule. Distinct occurrences of R11 have distinct step IDs."},
        "ref": {"oneOf": [{"type": "string", "pattern": "^R[0-9]+[A-Z]*$"}, {"type": "string", "pattern": "^M[0-9]+$"}]},
        "label": {"type": "string", "minLength": 1}
      },
      "required": ["id", "ref"]
    },
    "lane": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "context": {"type": "string", "minLength": 1},
        "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}, "minItems": 1}
      },
      "required": ["title", "context", "steps"]
    },
    "stage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "lanes": {"type": "array", "items": {"$ref": "#/$defs/lane"}, "minItems": 1}
      },
      "required": ["id", "lanes"]
    },
    "endpoint": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "step": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "label": {"type": "string", "minLength": 1}
      },
      "required": ["step", "label"]
    },
    "bridge": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "afterStage": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/endpoint"}, "minItems": 1},
        "output": {"$ref": "#/$defs/endpoint"}
      },
      "required": ["afterStage", "inputs", "output"]
    },
    "outcome": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "afterStep": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "title": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1},
        "proposed": {"type": "boolean"}
      },
      "required": ["id", "afterStep", "title", "detail", "proposed"]
    },
    "schedule": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "stages": {"type": "array", "items": {"$ref": "#/$defs/stage"}, "minItems": 1},
        "bridges": {"type": "array", "items": {"$ref": "#/$defs/bridge"}, "minItems": 0},
        "outcomes": {"type": "array", "items": {"$ref": "#/$defs/outcome"}, "minItems": 0}
      },
      "required": ["stages", "bridges", "outcomes"]
    }
  }
}
